{
  "redirects": [
    {
      "source": "/:path((?!magic-AI)[mM][aA][gG][iI][cC]-[aA][iI])/:rest*",
      "destination": "/magic-AI",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/magic-AI(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    }
  ]
}
